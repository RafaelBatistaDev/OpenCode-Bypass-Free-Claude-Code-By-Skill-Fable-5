bun -e '
import os from "node:os";
import path from "node:path";

const configPath = path.join(os.homedir(), ".claude.json");
const file = Bun.file(configPath);
const json = await file.json();

json.primaryApiKey = "sk-bypass";
json.openRouterApiKey = "sk-bypass";

if (json.clientDataCacheSlots) {
    for (const key of Object.keys(json.clientDataCacheSlots)) {
        json.clientDataCacheSlots[key].model = "oc/deepseek-v4-flash-free";
    }
}

json.additionalModelOptionsCache = [
    { value: "oc/deepseek-v4-flash-free", label: "DeepSeek V4 Flash Free", description: "DeepSeek flash free model with reasoning" },
    { value: "oc/ling-3.0-flash-free", label: "Ling 3.0 Flash Free", description: "Ling flash free model with reasoning" },
    { value: "oc/north-mini-code-free", label: "North Mini Code Free", description: "North mini code free model" },
    { value: "oc/mimo-v2.5-free", label: "MiMo-V2.5 Free", description: "MiMo V2.5 free model" },
    { value: "oc/laguna-s-2.1-free", label: "Laguna S 2.1 Free", description: "Laguna S 2.1 free model" },
    { value: "oc/nemotron-3-ultra-free", label: "Nemotron 3 Ultra Free", description: "Nemotron 3 Ultra free model" },
];

await Bun.write(configPath, JSON.stringify(json, null, 2));

// 1.1. Definir modelo padrão nas definições do Claude Code
const settingsPath = path.join(os.homedir(), ".claude", "settings.json");
const settingsFile = Bun.file(settingsPath);
const settings = await settingsFile.exists() ? await settingsFile.json() : {};
settings.model = "oc/deepseek-v4-flash-free";
await Bun.write(settingsPath, JSON.stringify(settings, null, 2));

console.info("Configuracao do Claude atualizada com sucesso!");
'